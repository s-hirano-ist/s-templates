{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update mise tools embedded in the GitHub Actions lint workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/github-actions-lint\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\s+[^\\r\\n=]+\\s*=\\s*\"(?<currentValue>[^\\\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": false
    }
  ],
  "constraints": {
    "ghActionsLock": "v0.4.1"
  }
}
