{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update mise tools embedded in the GitHub Actions lint workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/github-actions-lint\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+)\\s+[A-Za-z0-9_-]+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
